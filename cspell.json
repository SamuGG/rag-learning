{
  "version": "0.2",
  "language": "en-GB",
  "words": [
    "ACMR",
    "biomejs",
    "bradlc",
    "bunfig",
    "bunx",
    "chunker",
    "chunkers",
    "commitlint",
    "embedder",
    "fastembed",
    "huggingface",
    "HyDE",
    "hyde",
    "imdb",
    "mlx",
    "MLX",
    "mlx_lm",
    "myenv",
    "nitro",
    "ollama",
    "onnx",
    "onnxruntime",
    "pinecone",
    "qwen",
    "reranker",
    "reranking",
    "screenplay",
    "screenplays",
    "solidjs",
    "solidstart",
    "stripspace",
    "tailwindcss",
    "tanstack",
    "tokenizers",
    "venv",
    "vinxi",
    "wordpiece"
