  "flagWords": ["hte", "wehn"],
  "ignorePaths": [
    "*.lock",
    "cspell.json",
    "bun.lock",
    "node_modules",
    ".cache",
    ".output",
    ".nitro",
    ".vinxi",
    "coverage",
