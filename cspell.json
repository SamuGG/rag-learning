    "data/screenplays"
  ],
  "ignoreRegExpList": ["Urls", "Email", "^Co-Authored-By:.*$", "^Claude-Session:.*$", "`[^`\\n]+`"],
  "overrides": [
    {
      "filename": "**/*.{ts,tsx,js,cjs,mjs,json,yml}",
      "language": "en-GB,en-US"
    }
  ]
}
