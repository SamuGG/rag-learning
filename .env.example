# Copy to .env and adjust. Bun loads .env automatically.

# Chat LLM (Ollama)
OLLAMA_HOST=http://127.0.0.1:11434
CHAT_MODEL=qwen3.5:4b
OLLAMA_NUM_CTX=8192
OLLAMA_THINK=false
LLM_TEMPERATURE=0.7

# Embeddings (fastembed model id, downloaded on first use)
EMBEDDING_MODEL=fast-bge-small-en-v1.5
EMBEDDING_CACHE_DIR=.cache/fastembed

# Documents: folder holding manifest.json and the screenplay .txt files
# Use data/samples to try the committed synthetic samples.
SCREENPLAYS_DIR=data/screenplays

# Retrieval
TOP_K=5

# Pinecone (free Starter plan)
PINECONE_API_KEY=
PINECONE_INDEX=rag-screenplays
PINECONE_NAMESPACE=screenplays

# Web server (bind to localhost only)
HOST=127.0.0.1
PORT=3000

# Optional: Chrome/Chromium path for Bun.WebView end-to-end tests on Linux
# BUN_CHROME_PATH=/path/to/chrome

# Optional: run end-to-end tests against an already running app instead of the production build
# E2E_BASE_URL=http://127.0.0.1:3000

# Optional: run the UI against fake LLM and retriever (end-to-end tests)
# FAKE_SERVICES=true
